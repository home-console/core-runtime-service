## Core Runtime Service (.env)
#
# This file is a template. Copy it to `.env` and fill secrets locally:
#   cp .env.example .env
#
# IMPORTANT:
# - Do not commit `.env` (it contains secrets).
# - Values below are intentionally placeholders.
#

# --- Security / crypto ---
# Core runtime now bootstraps these into SecretStore on first start (encrypted at rest),
# and exposes them via env internally for legacy readers.
# You generally do NOT need to set these manually anymore.
# If you must override (e.g. migration), set them here:
# CSRF_SECRET=...
# OAUTH_ENCRYPTION_KEY=...

# --- Runtime storage ---
RUNTIME_STORAGE_MODE=dual
RUNTIME_VAULT_STORAGE_TYPE=sqlite
# In containers we run as non-root; keep DBs on the mounted /data volume.
RUNTIME_DB_PATH=/data/runtime.db
RUNTIME_VAULT_DB_PATH=/data/vault.db
RUNTIME_VAULT_SECRET_STORAGE_TYPE=sqlite
RUNTIME_VAULT_SECRET_DB_PATH=/data/vault_secret.db

# --- Dev / debugging ---
# По умолчанию debug выключен, rate limiting включён.
# Для локальной разработки можно выставить DEBUG=1 или DEBUG_MODE=1.
DEBUG=0
DEBUG_MODE=0
RUNTIME_RATE_LIMITING_ENABLED=true

# --- Plugins ---
RUNTIME_INSTALL_PLUGIN_DEPS=1
RUNTIME_PLUGINS_DIR=plugins

# --- SecretStore master key (REQUIRED) ---
# Single external bootstrap secret. Everything else should be stored in SecretStore.
RUNTIME_MASTER_KEY=CHANGE_ME__DEV_ONLY

# --- Yandex OAuth (REQUIRED if you use Yandex auth/plugins) ---
# Without this, runtime may fall back to an insecure hardcoded secret in some flows.
# Set it in your local `.env` / Coolify env.
# YANDEX_CLIENT_SECRET=CHANGE_ME__YANDEX_CLIENT_SECRET

# Optional: where the remote agent binary is located on your machine.
# AGENT_BINARY_PATH=/absolute/path/to/remote-client/build

# --- External events ---
# Set to 0 to disable watchdog warnings in local dev.
EXTERNAL_EVENTS_PUBLISHER_WARN_DELAY_SECONDS=0

# --- URL-префикс API (HTTP + WebSocket) ---
# RUNTIME_API_PREFIX: при маунте FastAPI литерал /api/v1 в путях HttpEndpoint
# заменяется на этот префикс (default /api/v1).
# RUNTIME_API_PREFIX=/api/v2
# WebSocket (например /api/v1/admin/ssh/ws/...) маунтится под тем же префиксом, что и REST.

# --- Web dev (Vite runs on :5173) ---
# Only needed if you access core API directly from a different origin
# (i.e. without Vite proxy). If you use Vite proxy + same-origin, you can omit these.
RUNTIME_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# For local HTTP dev (no TLS), Secure must be false.
# If you run core behind HTTPS in dev, set SECURE=true.
RUNTIME_COOKIES_SAMESITE=none
RUNTIME_COOKIES_SECURE=false
