{
    "name": "client_manager",
    "version": "1.0.0",
    "description": "Управление удаленными агентами через WebSocket и REST API",
    "author": "Home Console",
    "license": "MIT",
    "type": "core",
    "class_path": "plugins.client_manager.plugin.ClientManagerPlugin",
    "requires": [
        "core"
    ],
    "is_integration": false,
    "provides": {
        "services": [
            "client_manager.websocket",
            "client_manager.admin_websocket",
            "client.command.execute",
            "client.list",
            "client.delete"
        ],
        "websocket_endpoints": [
            "/ws",
            "/admin/ws"
        ]
    },
    "config": {
        "enabled": true
    }
}
