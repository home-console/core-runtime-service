{
  "class_path": "plugins.client_manager.plugin.ClientManagerPlugin",
  "name": "client_manager",
  "version": "1.0.0",
  "description": "Client Manager Service - управление удалёнными клиентами через WebSocket",
  "author": "Home Console",
  "dependencies": [],
  "execution_mode": "container",
  "container_config": {
    "name": "plugin-client_manager",
    "image": "homeconsole-client-manager:dev",
    "build": {
      "dockerfile": "plugins/client-manager-service/Dockerfile",
      "context": "core-runtime-service",
      "auto_build": true
    },
    "ports": {
      "10000": "10000"
    },
    "env": {
      "JWT_SECRET_KEY": "${JWT_SECRET_KEY:-dev-secret-key-change-in-production}",
      "SERVER_ENCRYPTION_KEY": "${SERVER_ENCRYPTION_KEY:-dev-encryption-key-change-in-production}"
    },
    "args": [
      "--network", "homeconsole"
    ]
  }
}
